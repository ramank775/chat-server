{
  "name": "chat-server",
  "version": "3.0.0",
  "description": "A chat server based on the microservice architecture to ensure high availability, high throughput, horizontal scalability.",
  "main": "",
  "repository": "https://github.com/ramank775/chat-server.git",
  "author": "Raman <raman.jay14@gmail.com>",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\" \"services/**/test/*.test.js\"",
    "test:infra": "docker compose --env-file deployment/.env.tmpl -f deployment/docker-compose.infra.yml up -d mongo redis",
    "lint:fix": "eslint --fix .",
    "prepare": "husky install",
    "test:conformance:monolith": "CONFORMANCE_BASE_URL=${CONFORMANCE_BASE_URL:-http://localhost:8086} CONFORMANCE_MONGO_URL=${CONFORMANCE_MONGO_URL:-mongodb://root:password@localhost:27018/chat?authSource=admin} npm run test:conformance",
    "test:conformance": "CONFORMANCE_BASE_URL=${CONFORMANCE_BASE_URL:-http://localhost:8085} node --test test/conformance/*.test.js",
    "monolith": "node services/monolith.js",
    "monolith:up": "docker compose --env-file deployment/.env.tmpl -f deployment/docker-compose.monolith.yml up -d"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.592.0",
    "@aws-sdk/s3-request-presigner": "^3.592.0",
    "axios": "^1.7.2",
    "commander": "^11.1.0",
    "fastify": "^5.12.5",
    "hot-shots": "^10.0.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.1",
    "kafkajs": "2.2.4",
    "long": "^5.2.3",
    "moment": "^2.30.1",
    "mongodb": "^6.7.0",
    "nats": "^2.26.0",
    "protobufjs": "^7.2.5",
    "short-uuid": "^4.2.2",
    "winston": "^3.13.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/eslint-parser": "^7.24.7",
    "@babel/preset-env": "7.22.15",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^8.0.3",
    "prettier": "3.0.3"
  }
}
