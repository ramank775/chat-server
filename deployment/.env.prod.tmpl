# Production settings for docker-compose.prod.yml. Copy to `.env` next to it
# (git ignores .env) and fill in every value. Compose refuses to start while a
# required one is empty. README.md says where each comes from.

# Image tag to run (a release, never a -dev tag)
CHAT_SERVER_TAG=

# The API hostname phones connect to: https://$DOMAIN and wss://$DOMAIN/wss.
# Release builds default to vartalapapp.one9x.com (vartalap CI). Only Caddy
# reads it; host nginx has the name in its site file.
DOMAIN=vartalapapp.one9x.com

# Postgres user, created on first start. Long random password (hex, so it
# is safe inside the connection url):
#   openssl rand -hex 24
PG_USER=vartalap
PG_PASSWORD=

# Where OTP codes go: sms-gate-app (launch) or telegram (testing without a
# SIM: every code goes to your Telegram chat; README "Testing without a SIM").
SMS_SENDER=sms-gate-app

# OTP SMS via sms-gate.app (cloud mode: the username/password the app shows)
SMS_GATE_URL=https://api.sms-gate.app
SMS_GATE_USER=
SMS_GATE_PASSWORD=

# SMS_SENDER=telegram only: the bot token from @BotFather and your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Same-code OTP resend. Generate once; keep outside the database:
#   openssl rand -hex 32
OTP_ENCRYPTION_KEY=

# Web Push (VAPID). Generate once and keep: changing the pair stops push for
# every installed phone until it re-registers.
#   docker run --rm --entrypoint npx ramank775/chatserver:$CHAT_SERVER_TAG web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Play Store builds get push from Firebase (decision 209). Firebase console >
# Project settings > Service accounts > Generate new private key, then
#   base64 -w0 <downloaded>.json   (paste the output here, delete the file)
FCM_SERVICE_ACCOUNT_KEY=

# Cloudflare R2: R2 > Overview > account id; R2 > Manage API tokens >
# "Object Read & Write" scoped to the bucket.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=vartalap
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# App version check (decision 192): Android versionCode numbers, 0 = off.
# Below MIN_APP_BUILD the server refuses the app and it shows only an update
# screen; below LATEST_APP_BUILD it shows an "update available" bar. Raise
# them once the new build is live on Play and GitHub (README, Forcing an
# app update).
MIN_APP_BUILD=0
LATEST_APP_BUILD=0

# Behind the host's nginx (config/nginx/vartalap-host.conf): the app listens
# on 127.0.0.1:APP_PORT and COMPOSE_PROFILES stays empty. On a server where
# nothing else owns 80/443, COMPOSE_PROFILES=caddy runs Caddy on
# HTTP_PORT/HTTPS_PORT with its own certificate instead.
APP_PORT=8000
COMPOSE_PROFILES=
HTTP_PORT=80
HTTPS_PORT=443
