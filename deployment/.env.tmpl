# Infra
STAGE=dev
CHAT_SERVER_TAG=v3.0.0-dev.2
CONFIG_DIR=./config
# host ports (8081/9000 are commonly taken by other local stacks)
NGINX_PORT=8085
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011

# KAFKA TOPIC
TOPIC_NEW_MESSAGE=new-message
TOPIC_OFFLINE_MESSAGE=offline-message
TOPIC_NEW_LOGIN=new-login
TOPIC_CLIENT_ACK_MESSAGE=client-ack

# CREATE TOPIC FOR NAMED SERVICE
PERSISTENCE_MESSAGE_MS_INITIAL=persistence-message

# EVENT STORE
EVENT_STORE=nats

# KAKFA CLIENT ID
GATEWAY_CLIENT_ID=gateway-1
MESSAGE_DELIVERY_CLIENT_ID=message-delivery-1
MESSAGE_ROUTER_CLIENT_ID=message-router-1
PROFILE_CLIENT_ID=profile-1
GROUP_CLIENT_ID=group-1
NOTIFICATION_CLIENT_ID=notification-1

# KAFKA OPTIONS
BROKER_LIST=kafka:9092
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# EVENT STORE CONSUMER GROUP
CONSUMER_GROUP_MESSAGE_DELIVERY=message-delivery
CONSUMER_GROUP_GATEWAY=gateway
CONSUMER_GROUP_NOTIFICATION=notification-ms
CONSUMER_GROUP_MESSAGE_STORAGE=message-storage

# MONGO URL
MONGO_URL=mongodb://mongo:27017/chat?authSource=admin
MONGO_USER=root
MONGO_PASSWORD=password

# Redis
REDIS_ENDPOINT=redis:6379

# Push Notification (ntfy topics must be https, so local runs use the mock sender)
PN_SERVICE=mock
NTFY_BASE_URL=https://ntfy.vartalap
PN_TTL=3600

# s3 (minio). S3_ENDPOINT is what presigned urls are signed for, so it has to be
# reachable by the *client* that follows them, not by media-ms (which only signs).
S3_ACCESS_KEY_ID=vartalapdev
S3_SECRET_ACCESS_KEY=vartalapdevsecret
S3_BUCKET_NAME=vartalap
S3_ENDPOINT=http://localhost:9010
MAX_UPLOAD_SIZE=26214400
URL_EXPIRE_TIME=3600

# NATS
NATS_SERVER_LIST=nats://nats:4222
NATS_AUTH=
NATS_USER=
NATS_PASS=
NATS_AUTH_TOKEN=
NATS_NKEY=
NATS_USER_JWT=

# DEV ONLY: enables GET /v3.0/auth/dev/otp?phone=<e164>. Leave empty anywhere real.
PROFILE_DEV_FLAGS=--expose-dev-otp --otp-rate-ip-hour=200

# AUTH Provider (profile-ms)
AUTH_PROVIDER=self-hosted-otp

# SMS gateway for OTP delivery (mock, sms-gate-app)
SMS_SENDER=mock
SMS_GATE_URL=https://api.sms-gate.app
SMS_GATE_USER=
SMS_GATE_PASSWORD=
